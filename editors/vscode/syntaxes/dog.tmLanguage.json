{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "dog4",
  "scopeName": "source.dog",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comment-block"
        },
        {
          "include": "#comment-line"
        },
        {
          "include": "#string-double"
        },
        {
          "include": "#string-single"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#escape"
        },
        {
          "include": "#fn-declaration"
        },
        {
          "include": "#fn-keyword"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#map-key"
        },
        {
          "include": "#number"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#command"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.double-slash.dog",
      "begin": "(?<![^\\s;{}()\\[\\],])//",
      "end": "$"
    },
    "comment-block": {
      "comment": "Block comments nest, so the body includes this rule again.",
      "name": "comment.block.dog",
      "begin": "(?<![^\\s;{}()\\[\\],])/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "string-double": {
      "comment": "Double quotes interpolate; single quotes do not.",
      "name": "string.quoted.double.dog",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.dog",
      "begin": "(?<![^\\s;{}()\\[\\],])'",
      "end": "'"
    },
    "escape": {
      "name": "constant.character.escape.dog",
      "match": "\\\\."
    },
    "interpolation": {
      "patterns": [
        {
          "comment": "$(expr) \u2014 a full expression.",
          "name": "meta.interpolation.dog",
          "begin": "\\$\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.variable.dog"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.variable.dog"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "comment": "${name}",
          "name": "variable.other.dog",
          "match": "\\$\\{[\\p{L}_][\\p{L}_0-9]*\\}"
        },
        {
          "comment": "$f(args) \u2014 a call inside a word.",
          "name": "meta.interpolation.call.dog",
          "begin": "(\\$)([\\p{L}_][\\p{L}_0-9]*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.variable.dog"
            },
            "2": {
              "name": "entity.name.function.dog"
            },
            "3": {
              "name": "punctuation.section.arguments.dog"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.dog"
            }
          },
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "comment": "$%rest spread.",
          "name": "variable.other.dog",
          "match": "\\$%[\\p{L}_][\\p{L}_0-9]*"
        },
        {
          "comment": "$name.path[0] \u2014 the path tail is part of the variable.",
          "match": "(\\$)([\\p{L}_][\\p{L}_0-9]*)((?:\\.[\\p{L}_][\\p{L}_0-9]*|\\[[^\\]]*\\])*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.dog"
            },
            "2": {
              "name": "variable.other.dog"
            },
            "3": {
              "name": "variable.other.member.dog"
            }
          }
        }
      ]
    },
    "fn-declaration": {
      "comment": "`fn name (params)` \u2014 the name, then the parameter list.",
      "begin": "(?<![\\p{L}_0-9])(fn)(?![\\p{L}_0-9])[ \\t]*([\\p{L}_][\\p{L}_0-9]*)?[ \\t]*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.function.dog"
        },
        "2": {
          "name": "entity.name.function.dog"
        },
        "3": {
          "name": "punctuation.section.parameters.dog"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parameters.dog"
        }
      },
      "patterns": [
        {
          "include": "#comment-line"
        },
        {
          "include": "#comment-block"
        },
        {
          "comment": "`name: type`, `&name`, `%rest`.",
          "match": "(%?)([\\p{L}_][\\p{L}_0-9]*)[ \\t]*(?=[,:)])",
          "captures": {
            "1": {
              "name": "keyword.operator.dog"
            },
            "2": {
              "name": "variable.parameter.dog"
            }
          }
        },
        {
          "match": "([:&])[ \\t]*((?:num|str|arr|map|fn|bool|any|null)(?:\\|(?:num|str|arr|map|fn|bool|any|null))*\\??)",
          "captures": {
            "1": {
              "name": "punctuation.separator.dog"
            },
            "2": {
              "name": "support.type.dog"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.dog",
          "match": "(?<![\\p{L}_0-9])(if|else|while|for|in|split|try|catch|throw|return|break|continue|clear)(?![\\p{L}_0-9])"
        },
        {
          "name": "keyword.other.dog",
          "match": "(?<![\\p{L}_0-9])(let|use|as|from|mod|pub)(?![\\p{L}_0-9])"
        },
        {
          "name": "constant.language.dog",
          "match": "(?<![\\p{L}_0-9])(true|false|null)(?![\\p{L}_0-9])"
        },
        {
          "comment": "A type annotation follows `:` or `&` in a parameter list.",
          "match": "([:&])[ \\t]*(num|str|arr|map|fn|bool|any|null)\\b",
          "captures": {
            "1": {
              "name": "punctuation.separator.dog"
            },
            "2": {
              "name": "support.type.dog"
            }
          }
        }
      ]
    },
    "map-key": {
      "comment": "`name =` inside a map literal.",
      "match": "(?<=[\\[,])[ \\t]*([\\p{L}_][\\p{L}_0-9]*)[ \\t]*(?==(?!=))",
      "captures": {
        "1": {
          "name": "variable.other.member.dog"
        }
      }
    },
    "number": {
      "name": "constant.numeric.dog",
      "match": "(?<![^\\s;{}()\\[\\],=])-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?(?![^\\s;{}()\\[\\],=])"
    },
    "operator": {
      "name": "keyword.operator.dog",
      "match": "==|!=|<=|>=|&&|\\|\\||\\?\\?|\\.\\.|\\+=|-=|\\*=|/=|(?<=[\\s(])[-+*/%<>!](?=[\\s($\\d])|="
    },
    "command": {
      "comment": "An identifier opening a statement is a command invocation. Keywords are excluded explicitly: this rule starts matching at the line's indent, so it would otherwise win the earliest-match race against #keyword.",
      "match": "(?:^|(?<=[;{]))[ \\t]*(?!(?:if|else|while|for|in|split|try|catch|throw|return|break|continue|clear|let|use|as|from|mod|pub|fn|true|false|null)(?![\\p{L}_0-9]))([\\p{L}_][\\p{L}_0-9]*)(?![\\p{L}_0-9]*[ \\t]*=(?!=))",
      "captures": {
        "1": {
          "name": "entity.name.function.dog"
        }
      }
    },
    "fn-keyword": {
      "name": "keyword.declaration.function.dog",
      "match": "(?<![\\p{L}_0-9])fn(?![\\p{L}_0-9])"
    }
  }
}
