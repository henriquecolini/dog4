// A tiny event system: handlers are lambdas kept in a map of arrays.
_handlers = [=];
fn on (event: str, f: fn) {
    _handlers[$event] = ($_handlers[$event] ?? []) + [$f]
}
fn emit (event: str, data) {
    put for f in ($_handlers[$event] ?? []) { put ($f($data)) }
}
on greet fn (who) { pln "hello, $who!" };
on greet fn (who) { pln "(waves at $who)" };
on bye fn (who) { pln "see you, $who" };
put { emit greet dog4 };
put { emit bye dog4 };
put { emit nothing dog4 }
