// A function body can be a single value instead of a block: it returns that value.
fn say_hello(name) "Hello $name"
fn square (x: num) ($x * $x)
fn pick (c) if $c yes else no
fn pair (a, b) [$a $b]
fn sign (x: num) if ($x < 0) -1 else if ($x > 0) 1 else 0
pln { say_hello Ana } { square 4 } { pick true } { pick false } { pair 1 2 };
pln { sign -5 } { sign 0 } { sign 7 };
// Lambdas too, in commands, expressions and literals.
double = fn (x) ($x * 2);
fs = [fn (x) ($x + 1), fn (x) ($x - 1)];
pln ($double(5)) ($fs[0](1)) ($fs[1](1)) (map([1 2], fn (x) ($x * 10)));
pln { map [1 2 3] fn (x) "<$x>" };
// The body is one value, so a command needs braces.
fn shout (s: str) { upper $s }
pln { shout hey } { src square };
