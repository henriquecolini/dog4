fn double (x: num) { put ($x * 2) }
pln { double 21 } { double "2.5" } { double (4) };
fn words (xs: arr) { put { len $xs } }
pln { words "a b c" } { words [x y] };
fn flag (b: bool) { put $b }
pln { flag "" } { flag yes } { flag (0) };
fn label (s: str) { put "<$s>" }
pln { label 5 } { label (true) };
fn maybe (x: num?) { put { type $x } }
pln { maybe (null) } { maybe 3 };
fn either (x: str|num) { put { type $x } }
pln { either a } { either 1 };
