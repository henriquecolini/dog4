a = [0 1 2 3 4 5];
pln $a[1..3] $a[..2] $a[4..] $a[..] $a[-2..] $a[..-4];
// Out of range bounds are clamped; a reversed range is empty.
pln $a[3..1] $a[-100..2] $a[4..100] $a[6..];
s = "héllo wörld";
pln $s[0..5] "<$s[1..4]>" $s[-5..] { type $s[1..1] };
i = 1;
pln $a[$i + 1..$i * 4] ($a[1..][0]) { sum $a[..3] };
pln (null)[1..2] { type (null)[..] };
m = [list = [a b c]];
pln $m.list[1..] ([x y z][..1]);
