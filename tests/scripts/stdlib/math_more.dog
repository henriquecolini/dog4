pln { round 3.14159 2 } { round 1234 -2 } { round 2.5 } { trunc -2.7 } { sign -4 } { sign 0 } { sign 2.5 };
pln { clamp 15 0 10 } { clamp -1 0 10 } { clamp 5 0 10 } { abs -3 };
pln { exp 0 } { ln 1 } { log 1000 } { log 8 2 } { sin 0 } { cos 0 } { round { atan2 1 1 } 4 } { round { pi } 5 };
pln { fixed 3.14159 2 } { fixed 2 3 } { fixed -0.5 0 } { type { fixed 1 1 } };
pln { parse_int ff 16 } { parse_int -101 2 } { parse_int zz 36 } { to_base 255 16 } { to_base -5 2 } { to_base 0 2 };
pln { product [2 3 4] } { product [] } { avg [1 2 3 4] } { avg [] } { median [5 1 3] } { median [4 1 3 2] } { median "3 1 2" };
pln (try { parse_int 12 1 } catch e { put $e.message });
pln (try { parse_int 9 8 } catch e { put $e.message });
pln (try { avg [1 x] } catch e { put $e.message });
pln (try { clamp 1 5 0 } catch e { put $e.message });
