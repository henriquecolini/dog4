// An inline module behaves exactly like the same source imported from a file.
mod shape {
    unit = cm;
    pub fn area (w: num, h: num) { put "$($w * $h)$unit²" }
    pub sides = [square = 4, triangle = 3];
}
use "lib/shape" as file_shape;
pln ({ keys $shape } == { keys $file_shape }) ($shape.sides == $file_shape.sides);
pln { shape.area 2 3 } { file_shape.area 2 3 };
